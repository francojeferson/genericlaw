# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh
TELEGRAM_ALLOWED_USER_IDS=123456789

# LLM Providers (use ONE of these two approaches):
# 
# Option A: OpenRouter (recommended - single key for all models)
# OPENROUTER_API_KEY=sk-or-...
# LLM_PROVIDER=gemini
# LLM_PROVIDERS=gemini,deepseek,groq
#
# Option B: Native APIs (separate keys per provider)
# LLM_PROVIDER=gemini
# LLM_PROVIDERS=gemini,deepseek
# GEMINI_API_KEY=...
# DEEPSEEK_API_KEY=...
# GROQ_API_KEY=...

LLM_PROVIDER=gemini
LLM_PROVIDERS=gemini,deepseek
GEMINI_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=

# Agent Loop
MAX_ITERATIONS=5
LLM_TIMEOUT_MS=120000
LLM_RETRY_COUNT=3
LLM_RETRY_BASE_DELAY_MS=1000
TOOL_TIMEOUT_MS=30000

# Memory
MEMORY_WINDOW_SIZE=20
DB_PATH=./data/db.sqlite
DB_MAX_SIZE_MB=500

# Filesystem
WORKSPACE_ROOT=./output
TMP_DIR=./tmp
SKILLS_DIR=./agents/skills

# Logging
LOG_MESSAGE_CONTENT=false

# Audio (STT/TTS)
WHISPER_BINARY=whisper
WHISPER_MODEL=small
TTS_VOICE_ID=pt-BR-ThalitaMultilingualNeural
FFMPEG_BINARY=ffmpeg